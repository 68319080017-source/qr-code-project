  query ServerHeaderDeploys($id: String!, $activeStatuses: [Int!]) {
    server(id: $id) {
      id
      liveDeploy {
        ...serverHeaderDeploy
      }
      latestDeploy {
        ...serverHeaderDeploy
      }
    }
    activeDeploys: deploys(
      input: { serviceId: $id, statuses: $activeStatuses, limit: 1 }
    ) {
      ...serverHeaderDeploy
    }
  }

  fragment serverHeaderDeploy on Deploy {
    id
    status
    createdAt
    startedAt
    finishedAt
    commitId
    commitShortId
    commitMessage
    commitURL
    imageSHA
    externalImage {
      imageRef
    }
    triggerDetails {
      type
    }
    artifact {
      id
      artifactSource {
        id
        name
      }

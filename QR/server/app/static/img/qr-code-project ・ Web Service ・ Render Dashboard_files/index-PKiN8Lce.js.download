  mutation updateServerCacheProfile(
    $id: String!
    $cacheProfile: ServerCacheProfile!
  ) {
    updateServerCacheProfile(id: $id, cacheProfile: $cacheProfile) {
      id
      cacheProfile
    }
  }
`),g8=new ur(H`
  query serverCacheProfileQuery($id: String!) {
    server(id: $id) {
      id
      cacheProfile
    }
  }
`),mle=new pr(H`
  mutation purgeServerCache($id: String!) {
    purgeServerCache(id: $id) {
      id
    }
  }
`),_8=new ur(H`
  query serverCacheEvents($id: String!) {
    serviceEvents(
      serviceId: $id
      include: ["DeployStarted", "EdgeCachePurged", "EdgeCacheEnabled"]
      limit: 1
    ) {
      events {
        id
        timestamp
        ... on EdgeCachePurged {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on EdgeCacheEnabled {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on DeployStarted {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
      }
    }
  }

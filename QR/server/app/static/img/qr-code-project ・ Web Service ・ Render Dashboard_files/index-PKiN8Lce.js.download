  fragment sandboxListFields on Sandbox {
    id
    __typename
    status
    createdAt
    startedAt
    endedAt
    networkPolicy
    timeoutSeconds
    source {
      __typename
      ... on SandboxEmailSource {
        email
      }
      ... on SandboxTemplateSource {
        templateId
      }
    }
    region {
      id
      description
    }
    image {
      name
      registryUrl
    }
    plan {
      name
      cpus
      memoryGb
      storageGb
    }
  }
`,R3=new ur(H`
  query sandboxDetails($id: String!) {
    sandbox(id: $id) {
      ...sandboxListFields
    }
  }
  ${L3}
`),z3=new ur(H`
  query sandboxesForGroup($input: SandboxesForGroupFilterInput!) {
    sandboxesForGroup(input: $input) {
      cursor
      hasMore
      sandboxes {
        ...sandboxListFields
      }
      sortField
      sortDirection
    }
  }
  ${L3}
`),B3=new dr(H`
  subscription sandboxUpdated($id: String!) {
    sandbox(id: $id) {
      ...sandboxListFields
    }
  }
  ${L3}
`),V3=new dr(H`
  subscription sandboxesForGroupUpdated($sandboxGroupId: String!) {
    sandboxesForGroupUpdated(sandboxGroupId: $sandboxGroupId) {
      ...sandboxListFields
    }
  }
  ${L3}
`),H3=new pr(H`

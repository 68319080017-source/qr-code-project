  fragment deployMinimalFields on Deploy {
    id
    createdAt
    startedAt
    finishedAt
    status
    rollbackSupportStatus
    commitId
    commitShortId
    commitMessage
    commitURL
    imageSHA
    externalImage {
      imageRef
    }
    triggerDetails {
      type
      updatedProperty
      userAgent
      user {
        id
        email
        avatarDownload {
          url
        }
      }
    }
  }
`,w6=new ur(H`
  query deploysMinimal($input: DeployFilterInput!) {
    deploys(input: $input) {
      ...deployMinimalFields
    }
  }
  ${C6}
`),Poe=new dr(H`
  subscription deployCreatedMinimal($serverId: String!) {
    deployCreated(serverId: $serverId) {
      ...deployMinimalFields
    }
  }
  ${C6}
`),Foe=new dr(H`
  subscription deployUpdatedMinimal($deployId: String!) {
    deployUpdated(deployId: $deployId) {
      ...deployMinimalFields
    }
  }
  ${C6}
`),Ioe=new dr(H`
  subscription serviceDeployStartedEvent($serviceId: String!) {
    serviceEvents(serviceId: $serviceId) {
      id
      __typename
    }
  }

  query artifactSourcePreview($id: String!) {
    artifactSource(id: $id) {
      id
      name
      buildConfig {
        repoNode {
          id
          sourceBranch
          repo {
            id
            provider
            name
            ownerName
            webURL
          }
        }
      }
      externalImage {
        imageHost
        imageRepository
        imageName
        imageRef
      }
      latestArtifact {
        id
        build {
          id
          status
        }
      }
    }
  }
`),OG=new ur(H`
  query artifactSourcePreviewLiveDeploy($serverId: String!) {
    server(id: $serverId) {
      id
      state
      liveDeploy {
        id
        artifact {
          id
          artifactSource {
            id
          }
        }
      }
    }
  }
